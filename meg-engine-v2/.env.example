# Server
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DATA_DIR=./data
MEG_API_KEY=
ALLOWED_ORIGINS=*

# Versioned behavior (record these with benchmark results)
ENGINE_VERSION=0.2.0
PROMPT_VERSION=meg-prompt-v2
ROUTER_VERSION=deterministic-router-v2
KNOWLEDGE_VERSION=pcos-general-v1

# Provider credentials. Leave unused providers blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_REFERER=https://bloom.app
OPENROUTER_TITLE=Bloom Meg Engine V2
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Routing. Each value is a comma-separated provider order.
FAST_PROVIDER_ORDER=gemini,groq,openrouter,ollama
SMART_PROVIDER_ORDER=openrouter,gemini,groq,ollama
SAFETY_PROVIDER_ORDER=openrouter,gemini,groq,ollama
DOCTOR_PROVIDER_ORDER=openrouter,gemini,groq,ollama
LOCAL_PROVIDER_ORDER=ollama
PRIMARY_FAST_PROVIDER=gemini
PRIMARY_SMART_PROVIDER=openrouter

# Feature flags
ENABLE_STREAMING=true
ENABLE_CACHE=true
ENABLE_LOCAL_FALLBACK=true
ENABLE_HEDGING=false
HEDGE_DELAY_MS=800

# Operational limits
FAST_TIMEOUT_MS=12000
SMART_TIMEOUT_MS=25000
SAFETY_TIMEOUT_MS=25000
LOCAL_TIMEOUT_MS=45000
PROVIDER_RETRIES=1
RETRY_BASE_DELAY_MS=80
RETRY_MAX_DELAY_MS=800
RETRY_JITTER_RATIO=0.25
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=60000
CIRCUIT_ROLLING_WINDOW_MS=120000
CIRCUIT_ROLLING_MIN_REQUESTS=5
CIRCUIT_FAILURE_RATE_THRESHOLD=0.6
CACHE_TTL_MS=900000
PROMPT_TOKEN_BUDGET=4200
MAX_OUTPUT_TOKENS=900
MAX_MESSAGE_CHARS=10000
MAX_MESSAGE_ID_CHARS=160
RECENT_MESSAGE_LIMIT=8
MEMORY_LIMIT=5
IDEMPOTENCY_STALE_MS=120000
SSE_HEARTBEAT_MS=15000
RATE_LIMIT_PER_MINUTE=0
