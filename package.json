{
  "name": "bloom",
  "version": "1.0.2",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node server/all.test.js",
    "test:backend": "node server/megBackend.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bloom-auth \"node server/firestore.rules.test.js\"",
    "test:meg": "node server/smokeTest.js",
    "generate:brand-assets": "node scripts/generate-logo-assets.js",
    "test:beta": "node server/betaAccess.test.js",
    "test:beta-email": "node server/betaLaunchEmail.test.js",
    "beta-email:dry-run": "node scripts/send-beta-launch-emails.js --mode=production --dry-run",
    "beta-email:dry-test": "node scripts/send-beta-launch-emails.js --mode=test --dry-run",
    "beta-email:test": "node scripts/send-beta-launch-emails.js --mode=test",
    "beta-email:production": "node scripts/send-beta-launch-emails.js --mode=production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@types/react": "~18.2.79",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "expo": "~51.0.0",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.9",
    "expo-screen-capture": "~6.0.1",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "express": "^4.22.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-calendars": "^1.1305.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.24.0",
    "pngjs": "3.4.0"
  },
  "private": true
}
