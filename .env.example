# Bloom frontend. Every EXPO_PUBLIC value is bundled into the app and is public.
# Copy the Firebase Web App configuration from Firebase Console > Project settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Existing Bloom backend URL. Keep the same value you already use for Meg.
# Local development:
EXPO_PUBLIC_MEG_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_MEG_QA_TIMING=0
# Production example:
# EXPO_PUBLIC_MEG_API_URL=https://meg-api.your-domain.example

# Bloom backend runtime.
NODE_ENV=development
PORT=3001
MEG_SERVER_HOST=127.0.0.1
# In production, omit MEG_SERVER_HOST so Bloom binds to 0.0.0.0 and honors PORT.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8084,http://127.0.0.1:8084
BUILD_VERSION=development

# Firebase Admin: existing Bloom server configuration. Never expose these as EXPO_PUBLIC.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to the base64 secret:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-service-account.json

# -----------------------------------------------------------------------------
# MEG V2 — active Bloom Meg backend.
# Add at least one provider key. More than one enables automatic provider fallback.
# Routing, model defaults, retries, safety, memory, and fallback order have defaults.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Production memory must use storage that survives restart/redeploy.
# The Docker image uses /var/lib/bloom/meg-v2; mount a persistent volume there.
# MEG_V2_DATA_DIR=/var/lib/bloom/meg-v2

# Optional overrides only — leave these unset unless you intentionally want to tune Meg V2.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
# PRIMARY_FAST_PROVIDER=gemini
# PRIMARY_SMART_PROVIDER=openrouter
# RATE_LIMIT_PER_MINUTE=60
# ENABLE_LOCAL_FALLBACK=false

EXPO_PUBLIC_BLOOM_STRENGTH=0
