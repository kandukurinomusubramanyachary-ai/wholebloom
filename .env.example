# Bloom frontend. Every EXPO_PUBLIC value is bundled into the app and is public.
# Copy the Firebase Web App configuration from Firebase Console > Project settings.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development only. A physical development phone can use the laptop LAN
# address. EAS preview/production must instead define a public HTTPS endpoint.
# Localhost, loopback and private-LAN URLs are rejected in production builds.
EXPO_PUBLIC_MEG_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_MEG_QA_TIMING=0
# EAS preview/production example (set in the matching EAS environment):
# EXPO_PUBLIC_MEG_API_URL=https://meg-api.your-domain.example

# Bloom backend runtime. Development code accepts only localhost/127.0.0.1 on
# Expo ports 8081-8090. Production uses this exact comma-separated allowlist.
NODE_ENV=development
PORT=3001
MEG_SERVER_HOST=127.0.0.1
# In production, omit MEG_SERVER_HOST so Bloom binds to 0.0.0.0 and honors PORT.
# MEG_SERVER_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8084,http://127.0.0.1:8084
BUILD_VERSION=development
MEG_QA_TIMING=0

# Firebase Admin: server only. Never use EXPO_PUBLIC for these values.
FIREBASE_PROJECT_ID=
# Secret: base64-encoded service-account JSON. Prefer your host's secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to the base64 secret: a path outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-service-account.json

# Meg provider. Use "ollama" for local development.
MEG_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
MEG_REQUEST_TIMEOUT_MS=90000
# Legacy timeout alias, used only if MEG_REQUEST_TIMEOUT_MS is absent.
# OLLAMA_TIMEOUT_MS=90000

# For MEG_PROVIDER=openai-compatible, all three values below are required.
# Production requires HTTPS for this provider URL.
# MEG_API_BASE_URL=https://provider.example/v1
# MEG_API_KEY=
# MEG_MODEL=

# Authenticated live Meg smoke test. MEG_TEST_ID_TOKEN is a short-lived secret.
# MEG_API_URL=http://127.0.0.1:3001
# MEG_TEST_ID_TOKEN=

# Disconnected Bloom Beta launch-email admin CLI retained for prior waitlist work.
BLOOM_BETA_URL=https://your-bloom-domain.example
EMAIL_FROM_NAME=Bloom
EMAIL_FROM_ADDRESS=beta@your-verified-domain.example
# Secret: Resend provider key.
EMAIL_PROVIDER_API_KEY=
# Optional delay, 250-10000 ms.
# BETA_EMAIL_BATCH_DELAY_MS=600
